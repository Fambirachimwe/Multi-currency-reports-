# Root environment placeholders. Each app has its own .env.example:
#   backend/.env.example  — server-side config and GAAP/MongoDB secrets (placeholders)
#   frontend/.env.example — public, browser-exposed config only
# Never commit real credentials. Copy examples to .env and fill in locally.

NODE_ENV=development

# Catalog (GAAP /products) is stored in MongoDB; this only sets when it is labelled expired (hours, 1-720).
# CATALOG_CACHE_TTL_HOURS=24

# Hybrid cache (nodes and catalog; same variables with NODES_ or CATALOG_ prefix).
# TTL_HOURS 1-720 (default 24). REFRESH_POLICY: manual (default; expired data is served labelled
# stale, only the refresh endpoint calls GAAP) or on_expiry (a read of expired data refetches and
# falls back to the stored copy, labelled stale, if GAAP fails). RETRY_COOLDOWN_SECONDS 0-3600
# (default 30): pause between GAAP retries after a failed on_expiry refetch.
# NODES_CACHE_TTL_HOURS=24
# NODES_CACHE_REFRESH_POLICY=manual
# NODES_CACHE_RETRY_COOLDOWN_SECONDS=30
# CATALOG_CACHE_REFRESH_POLICY=manual
# CATALOG_CACHE_RETRY_COOLDOWN_SECONDS=30
# Sales are never cached in v1. Setting SALES_CACHE_ENABLED to anything but false aborts startup.
# SALES_CACHE_ENABLED=false

# Report request caps (POST /api/v1/reports). All defaults are PROVISIONAL, not owner-approved.
# REPORT_MAX_RANGE_DAYS=92
# REPORT_MAX_PRODUCTS=2000
# REPORT_MAX_NODES=1000
# REPORT_MAX_NODE_DAYS=50000

# Report execution (background, in-process, bounded). Defaults shown.
# REPORT_MAX_CONCURRENT_RUNS=1      # 1-10 reports generating at once
# REPORT_MAX_QUEUED_RUNS=5          # 0-100 waiting; more are refused with 503 REPORT_QUEUE_FULL
# REPORT_RUN_TIMEOUT_MS=1200000     # hard per-report deadline (1000-21600000)
# While the Feature 17 eligibility rules are unverified, reports are refused (422). Setting this
# to false overrides that block; reports then record "+unverified-rules" in calculationVersion.
# REPORT_REQUIRE_VERIFIED_RULES=true
