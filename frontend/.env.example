# Frontend environment (placeholders only).
# WARNING: any VITE_* variable is bundled into the browser and is PUBLIC.
# Never put GAAP API keys, MongoDB URIs or other secrets in this file.

# Dev-server only: where Vite proxies /api requests. Not exposed to the browser.
DEV_BACKEND_URL=http://localhost:4000

# Public base URL of the Express API used by the browser in deployed builds.
VITE_API_BASE_URL=/api/v1
