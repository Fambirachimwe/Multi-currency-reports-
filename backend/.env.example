
# Report execution (see ../.env.example for meanings)
# REPORT_MAX_CONCURRENT_RUNS=1
# REPORT_MAX_QUEUED_RUNS=5
# REPORT_RUN_TIMEOUT_MS=1200000
# REPORT_REQUIRE_VERIFIED_RULES=true

# Required in production (set in the Render dashboard; never commit real values)
# NODE_ENV=production
# PORT is provided by Render
# CORS_ORIGIN=https://your-frontend.onrender.com
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>
# GAAP_API_KEY=
# GAAP_API_BASE_URL=
# Optional GAAP tuning: GAAP_TIMEOUT_MS (default 30000), GAAP_MAX_CONCURRENCY, GAAP_MAX_RETRIES, GAAP_RETRY_BASE_DELAY_MS
