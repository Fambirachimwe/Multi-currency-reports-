# Backend environment (placeholders only — never commit real values).
# Copy to backend/.env for local development.

NODE_ENV=development
PORT=4000

# Allowed browser origin for CORS (wired up in Feature 02).
CORS_ORIGIN=http://localhost:5173

# MongoDB connection (wired up in Feature 05).
MONGODB_URI=mongodb://localhost:27017/simbisa-reporting

# GAAP Unity Data API (wired up in Feature 06). Server-side only.
GAAP_API_BASE_URL=https://your-gaap-data-api.example
GAAP_API_KEY=replace-with-gaap-api-key
